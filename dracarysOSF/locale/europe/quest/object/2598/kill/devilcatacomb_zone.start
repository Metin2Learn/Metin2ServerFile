server_timer ( "floor7_eli_check_timer_1" , 5 , d . get_map_index ( ) ) 
if party . is_party ( ) then 
local pids = { party . get_member_pids ( ) } 
for i , pid in next , pids , nil begin 
q . begin_other_pc_block ( pid ) 
if pc . getf ( "devilcatacomb_zone" , "enter_time" ) > 0 then 
d . update_rank ( 216 , ( get_global_time ( ) - pc . getf ( "devilcatacomb_zone" , "enter_time" ) ) , pc . get_last_damage ( ) ) 
end 
q . end_other_pc_block ( ) 
end 
else 
if pc . getf ( "devilcatacomb_zone" , "enter_time" ) > 0 then 
d . update_rank ( 216 , ( get_global_time ( ) - pc . getf ( "devilcatacomb_zone" , "enter_time" ) ) , pc . get_last_damage ( ) ) 
end 
end 
